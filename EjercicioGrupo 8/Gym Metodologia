## 4. Pseudocódigo en PSeInt

```pseint
Algoritmo FitGymControl
	Definir n, i, plan, meses, entrenador, contVIPBlack, contBasico Como Entero
	Definir socio, socioMayor, nombrePlan Como Caracter
	Definir tarifa, subtotal, porcDesc, descuento, adicional Como Real
	Definir totalPagar, totalRecaudado, promedio, mayorPago Como Real
	
	Escribir "=== FITGYM CONTROL - GIMNASIO ==="
	Escribir "Basico $20 | VIP $35 | Black $50"
	Escribir "Descuento: 3-5 meses 5% | 6-11 meses 10% | 12 o mas 15%"
	Escribir "Entrenador: +$10 por mes"
	
	// Validar cantidad de socios
	Repetir
		Escribir "Cuantos socios desea registrar? (1-100): "
		Leer n
		Si n < 1 O n > 100 Entonces
			Escribir "[Error] Ingrese un valor entre 1 y 100."
		FinSi
	Hasta Que n >= 1 Y n <= 100
	
	// Inicializar acumulador, contadores y maximo
	totalRecaudado <- 0
	contVIPBlack <- 0
	contBasico <- 0
	mayorPago <- -1
	socioMayor <- ""
	
	Para i <- 1 Hasta n Con Paso 1 Hacer
		Escribir "----- Socio ", i, " de ", n, " -----"
		
		Repetir
			Escribir "Nombre del socio: "
			Leer socio
			Si Longitud(socio) = 0 Entonces
				Escribir "[Error] El campo no puede estar vacio."
			FinSi
		Hasta Que Longitud(socio) > 0
		
		Repetir
			Escribir "Plan (1 Basico, 2 VIP, 3 Black): "
			Leer plan
			Si plan < 1 O plan > 3 Entonces
				Escribir "[Error] Ingrese un valor entre 1 y 3."
			FinSi
		Hasta Que plan >= 1 Y plan <= 3
		
		Repetir
			Escribir "Meses contratados (1-24): "
			Leer meses
			Si meses < 1 O meses > 24 Entonces
				Escribir "[Error] Ingrese un valor entre 1 y 24."
			FinSi
		Hasta Que meses >= 1 Y meses <= 24
		
		Repetir
			Escribir "Incluye entrenador? (1 Si, 2 No): "
			Leer entrenador
			Si entrenador < 1 O entrenador > 2 Entonces
				Escribir "[Error] Ingrese 1 o 2."
			FinSi
		Hasta Que entrenador = 1 O entrenador = 2
		
		// Tarifa segun plan
		Segun plan Hacer
			1:
				tarifa <- 20
				nombrePlan <- "Basico"
				contBasico <- contBasico + 1
			2:
				tarifa <- 35
				nombrePlan <- "VIP"
				contVIPBlack <- contVIPBlack + 1
			3:
				tarifa <- 50
				nombrePlan <- "Black"
				contVIPBlack <- contVIPBlack + 1
		FinSegun
		
		subtotal <- tarifa * meses
		
		
		Si meses >= 12 Entonces
			porcDesc <- 0.15
		SiNo
			Si meses >= 6 Entonces
				porcDesc <- 0.10
			SiNo
				Si meses >= 3 Entonces
					porcDesc <- 0.05
				SiNo
					porcDesc <- 0
				FinSi
			FinSi
		FinSi
		descuento <- subtotal * porcDesc
		
		
		Si entrenador = 1 Entonces
			adicional <- 10 * meses
		SiNo
			adicional <- 0
		FinSi
		
		totalPagar <- subtotal - descuento + adicional
		
		Escribir ">> Resumen de ", socio
		Escribir "Plan ", nombrePlan, " x ", meses, " meses: $", subtotal
		Escribir "Descuento: -$", descuento
		Escribir "Entrenador: +$", adicional
		Escribir "TOTAL A PAGAR: $", totalPagar
		
		
		totalRecaudado <- totalRecaudado + totalPagar
		Si totalPagar > mayorPago Entonces
			mayorPago <- totalPagar
			socioMayor <- socio
		FinSi
	FinPara
	
	promedio <- totalRecaudado / n
	
	Escribir "========= REPORTE FINAL ========="
	Escribir "Socios procesados: ", n
	Escribir "Recaudo total: $", totalRecaudado
	Escribir "Planes Basico: ", contBasico
	Escribir "Planes VIP/Black: ", contVIPBlack
	Escribir "Promedio pagado: $", promedio
	Escribir "Socio que mas pago: ", socioMayor, " ($", mayorPago, ")"
	Escribir "Programa finalizado correctamente. Hasta pronto!"
FinAlgoritmo
```

